# Public gateway port. The host may inject PORT; 20339 is the assigned custom-app port.
PORT=20339

# MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=s22100684_AssignMate
DB_USER=s22100684_AssignMate
DB_PASSWORD=

# Login session lifetime in days
SESSION_DAYS=7

# Google OAuth for per-user Gmail sending
# Create a Google Cloud OAuth 2.0 Web application client and enable the Gmail API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production. For local development, set PORT=20201 and override with http://localhost:20201/user_service/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://assignmate.dcism.org/user_service/api/auth/google/callback

# Shared secret for task_service -> user_service send-email calls.
INTERNAL_API_KEY=change-me-long-random-string

# Send one reminder when the task is within this many days of its deadline.
REMINDER_DAYS_BEFORE=2
REMINDER_CHECK_INTERVAL_MINUTES=60
